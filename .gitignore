# Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Test, coverage, and local runtime output
.pytest_cache/
.pytest_cache*/
.pytest_tmp/
.pytest_tmp*/
.pytest_runtime/
.test_runtime/
.coverage
coverage.xml
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

# Logs, temporary files, and local Docker/database state
logs/*
!logs/.gitkeep
tmp/
.docker_config/
postgres_data/
docker-data/
*.pgdata

# Local application documents and generated artifacts
data/processed/*
!data/processed/.gitkeep
!data/processed/uploads/
data/processed/uploads/*
!data/processed/uploads/.gitkeep
data/processed/redacted/

# Synthetic sample PDFs are reviewed fixtures and may be published.
data/sample_pdfs/*
!data/sample_pdfs/.gitkeep
!data/sample_pdfs/*.pdf

# Downloaded datasets and prepared evaluation payloads
data/external/**
!data/external/.gitkeep
!data/external/*/
!data/external/*/.gitkeep
data/evaluation/raw/**
!data/evaluation/raw/.gitkeep
!data/evaluation/raw/*/
!data/evaluation/raw/*/.gitkeep
data/evaluation/processed/**
!data/evaluation/processed/.gitkeep
!data/evaluation/processed/*/
!data/evaluation/processed/*/.gitkeep
data/evaluation/results/
evaluation/results/

# Model and local inference caches. Keep the application source package visible.
/models/
model_cache/
transformer_cache/
huggingface/
.huggingface/
.cache/huggingface/
ollama/
ollama_models/
*.safetensors
*.bin

# Streamlit project configuration is intentionally tracked.
.streamlit/*
!.streamlit/config.toml

# Local-only visual design references.
docs/ui-reference/
