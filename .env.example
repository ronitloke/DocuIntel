# Copy this file to .env for local configuration. Do not commit real secrets.
APP_NAME=DocuIntel
APP_ENV=development
LOG_LEVEL=INFO
# Docker Compose reaches a host-installed Ollama through host.docker.internal.
# For a host-run FastAPI process, use http://127.0.0.1:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
SUMMARY_BATCH_MAX_CHARS=6000
SUMMARY_FINAL_MAX_CHARS=12000
SUMMARY_GROUNDING_ENABLED=true
SUMMARY_GROUNDING_MAX_PASSES=2
STRUCTURED_EXTRACTION_MAX_FIELDS=10
STRUCTURED_EXTRACTION_MAX_CONTEXT_CHARS=12000
TABLE_QUERY_MAX_ROWS=10000
COMPARISON_MAX_BLOCKS=1000
COMPARISON_MAX_CONTENT_CHARS=100000
COMPARISON_SUMMARY_MAX_CHARS=12000
MAX_UPLOAD_SIZE_MB=25
OCR_CANDIDATE_CHAR_THRESHOLD=20
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_RENDER_DPI=300

# Module 4 structure-aware chunking and local embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=150

# Module 5 search configuration.
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=50
HYBRID_RRF_K=60
SEARCH_CANDIDATE_MULTIPLIER=4
# SEMANTIC_MIN_SIMILARITY=0.25
SEARCH_MAX_QUERY_CHARS=1000
POSTGRES_TEXT_SEARCH_CONFIG=english

# Module 6 cross-encoder reranking.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
RERANK_CANDIDATE_COUNT=20
RERANK_CANDIDATE_MULTIPLIER=4
RERANK_MAX_CANDIDATES=200
RERANK_DEFAULT_ENABLED=false

# Module 7 grounded RAG answer generation and Module 8 conversation memory.
RAG_DEFAULT_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
# Explicit multi-document RAG scope limits and per-document candidate budget.
RAG_MAX_SELECTED_DOCUMENTS=20
RAG_SELECTED_DOCUMENT_CANDIDATE_MULTIPLIER=4
RAG_MAX_SELECTED_CANDIDATES=100
RAG_HISTORY_MAX_MESSAGES=10
RAG_HISTORY_MAX_CHARS=6000

# PostgreSQL / pgvector configuration for Modules 3 and 4.
POSTGRES_DB=docuintel
POSTGRES_USER=docuintel
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://docuintel:replace-with-a-local-password@localhost:55432/docuintel
TEST_DATABASE_URL=postgresql+psycopg://docuintel:replace-with-a-local-password@localhost:55432/docuintel_test

# Module 10 Streamlit frontend. The UI communicates with FastAPI over HTTP only.
DOCUINTEL_API_BASE_URL=http://127.0.0.1:8001
DOCUINTEL_API_TIMEOUT_SECONDS=180
# Optional fixed E5 package override; the default is the authoritative final run.
# DOCUINTEL_E5_RESULTS_DIR=data/evaluation/results/e5/final_baseline_20260821_final
